# Copy to .env and fill in. Which variables matter depends on how you run the app.
#
#   docker compose up  -> only OPENAI_API_KEY is required. docker-compose.yml
#                         supplies DATABASE_URL and QDRANT_URL itself, because
#                         inside Compose they must point at the db and qdrant
#                         service names rather than localhost.
#
#   uv run ...         -> everything below applies, as shown.

# --- Required in both modes -------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Native runs only (Compose overrides these) -----------------------------
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/debrief_db

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Must match the collection that ingestion wrote to. This is also the built-in
# default in core/config.py, so an unset value resolves to the same name.
QDRANT_COLLECTION_NAME=sales_knowledge_chunks
QDRANT_TIMEOUT_SECONDS=10

# --- Optional: Langfuse tracing ---------------------------------------------
# Unset means tracing is simply inactive. LANGFUSE_BASE_URL is the name the
# installed SDK reads; LANGFUSE_HOST is accepted as an alias.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Optional: behaviour toggles --------------------------------------------
# Backend-controlled rubric set appended to the analysis prompt.
# ANALYSIS_RUBRICS=overpitching_rubric.txt,discovery_rubric.txt,pricing_negotiation_rubric.txt
# DEBRIEF_AGENT_MODEL=gpt-5-mini
# Logs every retrieved RAG chunk (type, score, source, preview) to the API log.
# DEBRIEF_AGENT_LOG_RAG_CHUNKS=false

# --- Set only by docker-compose.yml, listed here for reference --------------
# Points the Streamlit UI at the API. Defaults to http://localhost:8000/api/upload
# when unset, which is correct for a native run.
# DEBRIEF_API_URL=http://api:8000/api/upload
